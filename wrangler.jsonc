{
  "name": "trackzapdj-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Passent toujours par le Worker : la racine "/" et "/merci" (choix de la langue),
    // et l'API de la boutique et des licences.
    "run_worker_first": ["/", "/index.html", "/merci", "/merci/", "/api/*"]
  },

  // Site en ligne (branche main) : vrais paiements.
  // Secrets à définir dans Cloudflare (Settings > Variables and secrets > Production) :
  // STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, LICENCE_PRIVATE_KEY.
  // Tant que PAYMENT_LINK_URL est vide, la boutique affiche « ventes pas encore ouvertes ».
  "vars": {
    "MODE": "live",
    "PAYMENT_LINK_URL": "",
    "PAYMENT_LINK_ID": ""
  },
  // Licences vendues (KV « trackzapdj-licences »).
  "kv_namespaces": [{ "binding": "LICENCES", "id": "4efcb12df84d4d528602600aeb96a5b7" }],

  // Previews (branche develop, site de test) : Stripe en mode test.
  // Rien n'est hérité du site en ligne : variables, secrets et stockage sont séparés.
  // Secrets : mêmes noms, réglés sur « Previews » dans Cloudflare.
  "previews": {
    "vars": {
      "MODE": "test",
      "PAYMENT_LINK_URL": "https://buy.stripe.com/test_7sY9ASazgcgpeBDh0TaR200",
      "PAYMENT_LINK_ID": "plink_1UX4kGCHAY76e5LthwbK5PTI"
    },
    // Licences de test (KV « trackzapdj-licences-preview »), jamais mélangées aux vraies.
    "kv_namespaces": [{ "binding": "LICENCES", "id": "c0d2207f66a548d3aa84174f6a6255b6" }]
  }
}
